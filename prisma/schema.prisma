// Aprumo — Diagnóstico de 90 dias
//
// ATENÇÃO / RF-23 + RNF-05:
// Este banco armazena EXCLUSIVAMENTE dados de marca (white-label) do contador.
// Nenhum dado financeiro do cliente final é modelado, trafegado ou persistido aqui.
// O diagnóstico (RF-05, RF-06, RF-09) é calculado 100% no navegador.
// Qualquer alteração que adicione campo financeiro a este schema viola RF-23.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Bloco único de configuração white-label (RF-30).
/// Trocar de cliente = criar/editar uma linha desta tabela, sem tocar em lógica ou estilo.
model Contador {
  id String @id @default(uuid())

  /// Dono da empresa: o `id` do usuário em `auth.users` (Supabase Auth).
  ///
  /// `@unique` implementa "uma empresa por conta". Toda leitura e escrita
  /// autenticada é filtrada por este campo no DAL (`src/lib/dal.ts`) — é ele
  /// que garante que um contador nunca alcança a empresa de outro.
  ///
  /// Sem chave estrangeira porque `auth.users` pertence ao schema do Supabase,
  /// fora do controle deste schema. A integridade é mantida pelo fluxo: só o
  /// DAL escreve aqui, e sempre com o id do usuário já autenticado.
  ownerId String @unique @map("owner_id") @db.Uuid

  /// Identificador da página pública: /d/<slug>
  slug String @unique

  /// Marca exibida no cabeçalho. Único campo obrigatório além do slug.
  marca String

  /// RF-32: opcionais — a página degrada sem eles, sem quebrar o layout.
  crc      String?
  logoUrl  String? @map("logo_url")
  whatsapp String?
  rodape   String?

  /// Cor primária em hex (#RRGGBB). Tem default para nunca degradar o layout.
  corPrimaria String @default("#0F766E") @map("cor_primaria")

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("contadores")
}

/// Candidatura à turma fundadora (camada comercial).
///
/// Dado de contato de um contador interessado — não é dado financeiro de
/// ninguém, então não conflita com RF-23/RNF-05. Continua valendo: nenhum
/// número do diagnóstico de nenhum empresário passa por aqui.
model Candidatura {
  id String @id @default(uuid())

  /// "Nome e escritório" chega num campo só, como no formulário.
  nomeEscritorio String @map("nome_escritorio")
  whatsapp       String

  /// Faixa de porte, não número exato — qualificação, não cadastro.
  clientesAtivos String @map("clientes_ativos")

  /// Os dois campos que qualificam e pesquisam ao mesmo tempo.
  origemUltimosClientes String @map("origem_ultimos_clientes")
  empresaParaEnviar     String @map("empresa_para_enviar")

  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("candidaturas")
}
