# =========================================================================
# Supabase — necessário para login e para o painel do contador.
# Sem estas variáveis o produto ainda sobe, mas /entrar e /painel ficam
# indisponíveis; só a página pública de diagnóstico funciona.
# =========================================================================

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
# Chave pública (anon / publishable). Vai para o navegador — é pública por
# design. O que protege os dados é o RLS da migration, não o sigilo dela.
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."

# URL pública do site, usada no link mágico enviado por e-mail.
# Em produção é obrigatória: sem ela o link é montado a partir do cabeçalho
# Host da requisição, que é controlado por quem chama.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =========================================================================
# Banco (Supabase Postgres) — guarda APENAS configuração de marca.
# Nenhum dado financeiro (RF-23 / RNF-05).
# =========================================================================

# Supabase > Project Settings > Database > Connection string > URI.
# Porta 6543 (pooler) em serverless; 5432 para rodar migrations.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Opcional: vincula as empresas do seed à sua conta, para poder editá-las
# no painel. Pegue o id em Supabase > Authentication > Users.
# SEED_OWNER_ID="00000000-0000-0000-0000-000000000000"

# =========================================================================
# Marca de fallback — usada só quando NÃO há DATABASE_URL.
# Serve para rodar e demonstrar o diagnóstico antes de existir Supabase.
# =========================================================================
NEXT_PUBLIC_MARCA_SLUG="demo"
NEXT_PUBLIC_MARCA_NOME="Seu Escritório Contábil"
NEXT_PUBLIC_MARCA_CRC=""
NEXT_PUBLIC_MARCA_LOGO_URL=""
NEXT_PUBLIC_MARCA_WHATSAPP=""
NEXT_PUBLIC_MARCA_RODAPE=""
NEXT_PUBLIC_MARCA_COR="#0F766E"
